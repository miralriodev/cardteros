---
interface Props {
  id: string;
  title: string;
  subtitle: string;
  priceMxn: number;
  imageUrl: string;
}

const {
  id,
  title,
  subtitle,
  priceMxn,
  imageUrl
} = Astro.props;

const formattedPrice = new Intl.NumberFormat('es-MX', {
  style: 'currency',
  currency: 'MXN',
  maximumFractionDigits: 0
}).format(priceMxn);
---

<div class="relative flex flex-col justify-between rounded-2xl bg-black border border-[#2a2a2a] hover:border-[#EDE4BE]/60 p-5 transition-all duration-300 hover:shadow-[0_15px_35px_rgba(0,0,0,0.85)] group">
  <!-- Imagen de la Caja / Pack -->
  <div class="relative w-full aspect-[4/3] rounded-xl overflow-hidden bg-[#0c0c0c] flex items-center justify-center p-3 mb-4 group-hover:bg-[#141414] transition-colors">
    <img
      src={imageUrl}
      alt={title}
      class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform duration-500 drop-shadow-[0_8px_16px_rgba(0,0,0,0.9)]"
      loading="lazy"
    />
  </div>

  <!-- Información de Producto -->
  <div class="flex-1 mb-4">
    <h3 class="font-heading text-2xl text-[#EDE4BE] group-hover:text-white transition-colors leading-tight tracking-wide mb-1">
      {title}
    </h3>
    <p class="text-xs text-[#8E8E8E] font-medium leading-relaxed">
      {subtitle}
    </p>
  </div>

  <!-- Controles: Selector de Cantidad, Precio y Botón AGREGAR -->
  <div class="pt-4 border-t border-[#252525] flex flex-col gap-3">
    <div class="flex items-center justify-between">
      <!-- Selector de Cantidad Stepper -->
      <div class="inline-flex items-center rounded-lg bg-[#181818] border border-[#333333] px-1 py-0.5" role="group" aria-label="Selector de cantidad">
        <button
          type="button"
          class="w-6 h-6 flex items-center justify-center text-[#EDE4BE] hover:text-white transition-colors text-xs font-bold"
          aria-label="Disminuir"
        >
          -
        </button>
        <span class="w-7 text-center text-xs font-mono font-bold text-white">
          1
        </span>
        <button
          type="button"
          class="w-6 h-6 flex items-center justify-center text-[#EDE4BE] hover:text-white transition-colors text-xs font-bold"
          aria-label="Aumentar"
        >
          +
        </button>
      </div>

      <!-- Precio -->
      <div class="text-right">
        <span class="font-heading text-xl text-[#EDE4BE] tracking-wider">
          {formattedPrice}
        </span>
      </div>
    </div>

    <!-- Botón Agregar Píldora Crema Oficial (#EDE4BE) -->
    <button
      type="button"
      class="w-full py-2.5 px-4 rounded-full font-heading text-base tracking-widest uppercase bg-[#EDE4BE] text-black hover:bg-white active:scale-[0.98] transition-all shadow-sm flex items-center justify-center cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#EDE4BE]"
      data-item-id={id}
    >
      AGREGAR
    </button>
  </div>
</div>
