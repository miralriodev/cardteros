---
import Navbar from '../organisms/Navbar.astro';
import Footer from '../organisms/Footer.astro';
import CartDrawer from '../organisms/CartDrawer.astro';
import '../../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CARDTEROS - Ya Llegamos | Breaks, Cajas y Slabs',
  description = 'La plataforma oficial para coleccionistas de cartas deportivas, breaks en directo y piezas graduadas de élite en México y Latinoamérica.'
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Bebas Neue (Athletic Display), Inter y JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="bg-[#111111] text-[#EDE4BE] font-body selection:bg-[#A72027] selection:text-[#EDE4BE] antialiased">
    <!-- Skip to content para accesibilidad WCAG -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 px-4 py-2 bg-[#EDE4BE] text-black font-bold rounded-md shadow-lg"
    >
      Saltar al contenido principal
    </a>

    <Navbar />
    <CartDrawer />

    <main id="main-content" class="w-full">
      <slot />
    </main>

    <Footer />

    <!-- Script de revelación suave al hacer scroll (Smooth Entrance Animation) -->
    <script>
      const observerCallback: IntersectionObserverCallback = (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          }
        });
      };

      const headingObserver = new IntersectionObserver(observerCallback, {
        root: null,
        rootMargin: '0px 0px -60px 0px',
        threshold: 0.15
      });

      document.querySelectorAll('.reveal-heading').forEach((el) => {
        headingObserver.observe(el);
      });
    </script>
  </body>
</html>
