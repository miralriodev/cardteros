---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { size = 'md', class: className = '' } = Astro.props;

const heightClass = {
  sm: 'h-7 sm:h-8',
  md: 'h-9 sm:h-11',
  lg: 'h-12 sm:h-14'
}[size];
---

<div class={`inline-flex items-center select-none ${className}`} aria-label="Cardteros">
  <img
    src="/assets/cardteros_logo.png"
    alt="Cardteros Oficial"
    class={`${heightClass} w-auto object-contain filter drop-shadow-[0_2px_8px_rgba(0,0,0,0.8)]`}
    loading="eager"
  />
</div>
