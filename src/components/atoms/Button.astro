---
interface Props {
  variant?: 'primary' | 'secondary' | 'gold' | 'outline' | 'ghost' | 'danger';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
  id?: string;
  href?: string;
  ariaLabel?: string;
}

const {
  variant = 'primary',
  size = 'md',
  type = 'button',
  disabled = false,
  class: className = '',
  id,
  href,
  ariaLabel,
  ...rest
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-semibold transition-all duration-200 cursor-pointer select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none disabled:cursor-not-allowed';

const sizeStyles = {
  sm: 'px-3 py-1.5 text-xs rounded-md gap-1.5',
  md: 'px-4 py-2.5 text-sm rounded-lg gap-2',
  lg: 'px-6 py-3.5 text-base rounded-xl gap-2.5 font-bold'
};

const variantStyles = {
  primary: 'bg-[#00E5FF] text-[#08090C] hover:bg-[#33EAFF] hover:shadow-[0_0_20px_rgba(0,229,255,0.4)] active:scale-[0.98]',
  secondary: 'bg-[#181D26] text-[#FFFFFF] border border-[#2C3445] hover:bg-[#1F2532] hover:border-[#00E5FF]/40 active:scale-[0.98]',
  gold: 'bg-gradient-to-r from-[#FFB800] to-[#FFA000] text-[#08090C] font-bold hover:shadow-[0_0_20px_rgba(255,184,0,0.4)] active:scale-[0.98]',
  outline: 'bg-transparent text-[#00E5FF] border border-[#00E5FF]/50 hover:bg-[#00E5FF]/10 hover:border-[#00E5FF] active:scale-[0.98]',
  ghost: 'bg-transparent text-[#D9E2EC] hover:text-[#FFFFFF] hover:bg-[#181D26] active:scale-[0.98]',
  danger: 'bg-[#FF3366] text-white hover:bg-[#FF1F57] hover:shadow-[0_0_20px_rgba(255,51,102,0.4)] active:scale-[0.98]'
};

const combinedClasses = `${baseStyles} ${sizeStyles[size]} ${variantStyles[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={combinedClasses} id={id} aria-label={ariaLabel} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={combinedClasses} id={id} disabled={disabled} aria-label={ariaLabel} {...rest}>
      <slot />
    </button>
  )
}
