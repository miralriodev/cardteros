---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const features = [
  {
    step: 'PASO 01',
    title: 'SELECCIONA TU PACK',
    description: 'Explora nuestra selección de cajas y sobres sellados de las marcas líderes del hobby mundial.',
    imageUrl: '/src/assets/paso1.png'
  },
  {
    step: 'PASO 02',
    title: 'CONFIGURA TÚ ENVIÓ',
    description: 'Dirección protegida y opciones de resguardo o envío express directo a tus manos.',
    imageUrl: '/src/assets/paso2.png'
  },
  {
    step: 'PASO 03',
    title: 'RIP IT, WE SHIP IT',
    description: 'Vive la apertura en vivo con nosotros o recibe tu producto 100% sellado de fábrica.',
    imageUrl: '/src/assets/paso3.png'
  }
];
---

<section class={`w-full bg-[#111111] py-28 border-b border-[#2c2c2c] ${className}`}>
  <div class="max-w-7xl mx-auto px-6 lg:px-12 text-center">
    
    <!-- Eyebrow y Título Centrado en 2 Líneas Masivas -->
    <div class="mb-16">
      <span class="text-xs font-mono font-medium tracking-[0.3em] text-[#8E8E8E] uppercase block mb-3 select-none reveal-heading">
        ¿CÓMO FUNCIONA?
      </span>
      <h2 class="font-heading text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-[#EDE4BE] tracking-wide uppercase leading-[0.9] select-none reveal-heading reveal-heading-delay-1">
        TODO PAQUETE<br />TENDRÁ SU CARDTERO
      </h2>
      <p class="text-xs sm:text-sm font-mono tracking-[0.2em] text-[#6E6E6E] uppercase mt-3 select-none reveal-heading reveal-heading-delay-2">
        VIVE LA EXPERIENCIA DE COLECCIONISTA
      </p>
    </div>

    <!-- Grid de 3 Cards de Beneficios (Paso 01, Paso 02, Paso 03 - Figma Spec 3945:750) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 text-left">
      {features.map((item) => (
        <div class="step-card p-5 sm:p-6 flex flex-col justify-between transition-all duration-300 hover:border-[#EDE4BE]/50 hover:shadow-[0_20px_45px_rgba(0,0,0,0.9)] hover:-translate-y-1 group">
          
          <!-- Contenedor / Recuadro Interior con Patrón de Puntos y Luz de Fondo (Figma Exact) -->
          <div class="step-image-box relative w-full aspect-square flex items-center justify-center p-6 mb-5 overflow-hidden">
            <img
              src={item.imageUrl}
              alt={item.title}
              class="max-w-full max-h-full object-contain filter drop-shadow-[0_16px_30px_rgba(0,0,0,0.95)] transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
          </div>

          <!-- Información y Badge "PASO 0X" (Figma Exact: Azul sólido tenue, texto blanco/celeste) -->
          <div>
            <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-heading font-normal tracking-wider uppercase mb-3 bg-[#204060] text-white">
              {item.step}
            </span>
            <h3 class="font-heading text-2xl sm:text-[28px] text-[#EDE4BE] group-hover:text-white transition-colors tracking-wide uppercase leading-tight mb-2">
              {item.title}
            </h3>
            <p class="text-xs sm:text-[13px] text-[#6E6E6E] uppercase font-heading tracking-wider leading-snug">
              {item.description}
            </p>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
