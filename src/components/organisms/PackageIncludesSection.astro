---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const features = [
  {
    step: 'PASO 01',
    title: 'SELECCIONA TU PACK',
    description: 'Explora nuestra selección de cajas y sobres sellados de las marcas líderes del hobby mundial.',
    imageUrl: '/src/assets/paso1.png'
  },
  {
    step: 'PASO 02',
    title: 'CONFIGURA TÚ ENVIÓ',
    description: 'Dirección protegida y opciones de resguardo o envío express directo a tus manos.',
    imageUrl: '/src/assets/paso2.png'
  },
  {
    step: 'PASO 03',
    title: 'RIP IT, WE SHIP IT',
    description: 'Vive la apertura en vivo con nosotros o recibe tu producto 100% sellado de fábrica.',
    imageUrl: '/src/assets/paso3.png'
  }
];
---

<section class={`w-full bg-[#111111] py-28 border-b border-[#2c2c2c] ${className}`}>
  <div class="max-w-7xl mx-auto px-6 lg:px-12 text-center">
    
    <!-- Eyebrow y Título Centrado en 2 Líneas Masivas -->
    <div class="mb-16">
      <span class="text-xs font-mono font-medium tracking-[0.3em] text-[#8E8E8E] uppercase block mb-3 select-none">
        ¿CÓMO FUNCIONA?
      </span>
      <h2 class="font-heading text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-[#EDE4BE] tracking-wide uppercase leading-[0.9] select-none">
        TODO PAQUETE<br />TENDRÁ SU CARDTERO
      </h2>
      <p class="text-xs sm:text-sm font-mono tracking-[0.2em] text-[#6E6E6E] uppercase mt-3 select-none">
        VIVE LA EXPERIENCIA DE COLECCIONISTA
      </p>
    </div>

    <!-- Grid de 3 Cards de Beneficios (Paso 01, Paso 02, Paso 03) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-left">
      {features.map((item) => (
        <div class="rounded-2xl bg-black border border-[#2a2a2a] hover:border-[#EDE4BE]/50 p-6 flex flex-col justify-between transition-all duration-300 hover:shadow-[0_15px_35px_rgba(0,0,0,0.9)] group">
          
          <!-- Imagen del Paso -->
          <div class="relative w-full aspect-[4/3] rounded-xl overflow-hidden bg-[#0c0c0c] flex items-center justify-center p-3 mb-6 group-hover:bg-[#141414] transition-colors">
            <img
              src={item.imageUrl}
              alt={item.title}
              class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform duration-500 drop-shadow-[0_8px_16px_rgba(0,0,0,0.85)]"
              loading="lazy"
            />
          </div>

          <!-- Info y Badge Paso -->
          <div>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-sm text-[10px] font-mono font-black uppercase tracking-wider mb-3 bg-[#244b70] text-[#78c0ff]">
              {item.step}
            </span>
            <h3 class="font-heading text-2xl text-[#EDE4BE] group-hover:text-white transition-colors tracking-wide uppercase mb-2">
              {item.title}
            </h3>
            <p class="text-xs text-[#8E8E8E] leading-relaxed">
              {item.description}
            </p>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
