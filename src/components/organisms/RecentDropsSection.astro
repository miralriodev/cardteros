---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<section id="drops" class={`w-full bg-[#111111] py-28 border-b border-[#2c2c2c] overflow-hidden ${className}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <!-- Eyebrow & Título Centrado en Bebas Neue -->
    <div class="mb-14">
      <span class="text-xs font-mono font-medium tracking-[0.3em] text-[#8E8E8E] uppercase block mb-2 select-none">
        DROPS RECIENTES
      </span>
      <h2 class="font-heading text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-[#EDE4BE] tracking-wide uppercase leading-none select-none mb-3">
        ALGUIEN ACABA DE ENCONTRAR ESTO
      </h2>
      <p class="text-xs sm:text-sm font-mono tracking-[0.2em] text-[#6E6E6E] uppercase select-none">
        CARTAS DE ÉLITE DESCUBIERTAS EN NUESTROS LIVE BREAKS
      </p>
    </div>

    <!-- Vitrina Coverflow en Arco 3D (5 Graded Slabs en Perspectiva) -->
    <div class="relative w-full max-w-5xl mx-auto flex items-center justify-center py-6 slab-coverflow-container">
      <div class="flex items-center justify-center -space-x-12 sm:-space-x-16 md:-space-x-20 overflow-visible">
        
        <!-- 1. Slab Extremo Izquierdo -->
        <div class="w-[140px] sm:w-[190px] md:w-[230px] slab-coverflow-far-left transition-all duration-500">
          <img
            src="/src/assets/tylersough_slab.png"
            alt="Tyler Shough RC Slab Graduado 1"
            class="w-full h-auto object-contain drop-shadow-2xl"
            loading="lazy"
          />
        </div>

        <!-- 2. Slab Izquierdo Intermedio -->
        <div class="w-[160px] sm:w-[220px] md:w-[270px] slab-coverflow-left transition-all duration-500">
          <img
            src="/src/assets/tylersough_slab.png"
            alt="Tyler Shough RC Slab Graduado 2"
            class="w-full h-auto object-contain drop-shadow-2xl"
            loading="lazy"
          />
        </div>

        <!-- 3. Slab Central (Destacado, Iluminado, 100% Opacidad) -->
        <div class="w-[200px] sm:w-[270px] md:w-[330px] slab-coverflow-center transition-all duration-500 cursor-pointer">
          <img
            src="/src/assets/tylersough_slab.png"
            alt="2025 Topps Rise Tyler Shough RC Auto Gem Mint 10"
            class="w-full h-auto object-contain drop-shadow-[0_25px_50px_rgba(0,0,0,0.95)]"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <!-- 4. Slab Derecho Intermedio -->
        <div class="w-[160px] sm:w-[220px] md:w-[270px] slab-coverflow-right transition-all duration-500">
          <img
            src="/src/assets/tylersough_slab.png"
            alt="Tyler Shough RC Slab Graduado 4"
            class="w-full h-auto object-contain drop-shadow-2xl"
            loading="lazy"
          />
        </div>

        <!-- 5. Slab Extremo Derecho -->
        <div class="w-[140px] sm:w-[190px] md:w-[230px] slab-coverflow-far-right transition-all duration-500">
          <img
            src="/src/assets/tylersough_slab.png"
            alt="Tyler Shough RC Slab Graduado 5"
            class="w-full h-auto object-contain drop-shadow-2xl"
            loading="lazy"
          />
        </div>

      </div>
    </div>

    <!-- Metadatos de la Carta Central y Controles (+20% Escala & Smooth Animations) -->
    <div class="mt-10 flex flex-col items-center gap-5">
      <!-- Título de la carta (+20% más grande, brillo sutil) -->
      <h3 class="font-heading text-3xl sm:text-4xl md:text-5xl lg:text-[54px] text-[#EDE4BE] tracking-widest uppercase leading-none transition-all duration-300 drop-shadow-[0_4px_20px_rgba(237,228,190,0.15)] hover:text-white">
        2025 TOPPS RISE • TYLER SHOUGH RC AUTO
      </h3>

      <!-- Subtítulo / Especificaciones (+20% escala) -->
      <p class="text-xs sm:text-sm md:text-base font-mono tracking-[0.25em] text-[#A0A0A0] uppercase font-medium">
        AUTO ON-CARD <span class="text-[#A72027] mx-1">•</span> SERIADO 1/1 <span class="text-[#A72027] mx-1">•</span> CALIFICACIÓN GEM MINT
      </p>

      <!-- Botones de Navegación Flechas y CTA Tienda (+20% escala y animaciones suaves premium) -->
      <div class="flex items-center gap-6 sm:gap-8 mt-4">
        <!-- Flecha Izquierda (+20%: w-10 h-10, icono SVG suave) -->
        <button
          type="button"
          class="w-10 h-10 rounded-full border border-[#444444] bg-[#141414]/80 text-[#EDE4BE] hover:bg-[#EDE4BE] hover:text-black hover:border-[#EDE4BE] hover:scale-110 active:scale-95 flex items-center justify-center transition-all duration-300 shadow-lg cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#EDE4BE]"
          aria-label="Anterior carta"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <!-- CTA Principal (+20% escala: px-10 py-3.5, font text-lg a text-xl, suave brillo y elevación) -->
        <a
          href="#paquetes"
          class="inline-flex items-center justify-center px-10 py-3.5 rounded-full font-heading text-lg sm:text-xl tracking-widest uppercase bg-[#EDE4BE] text-black hover:bg-white hover:scale-105 active:scale-95 transition-all duration-300 shadow-[0_10px_25px_rgba(237,228,190,0.2)] hover:shadow-[0_15px_35px_rgba(255,255,255,0.3)] font-medium"
        >
          VER EN LA TIENDA
        </a>

        <!-- Flecha Derecha (+20%: w-10 h-10, icono SVG suave) -->
        <button
          type="button"
          class="w-10 h-10 rounded-full border border-[#444444] bg-[#141414]/80 text-[#EDE4BE] hover:bg-[#EDE4BE] hover:text-black hover:border-[#EDE4BE] hover:scale-110 active:scale-95 flex items-center justify-center transition-all duration-300 shadow-lg cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#EDE4BE]"
          aria-label="Siguiente carta"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

  </div>
</section>
