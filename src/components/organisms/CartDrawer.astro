---
import Icon from '../atoms/Icon.astro';
---

<!-- Overlay backdrop -->
<div
  id="cart-overlay"
  class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 opacity-0 pointer-events-none transition-opacity duration-300"
  aria-hidden="true"
></div>

<!-- Cart Drawer Lateral Derecho Minimalista (Balsa-inspired) -->
<aside
  id="cart-drawer"
  class="fixed top-0 right-0 h-full w-full max-w-[420px] bg-[#0c0c0c] border-l border-[#222222] z-50 flex flex-col justify-between translate-x-full transition-transform duration-300 ease-out shadow-[-20px_0_50px_rgba(0,0,0,0.85)]"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cart-drawer-title"
>
  <!-- Header Minimalista -->
  <div class="px-6 py-5 border-b border-[#1f1f1f] flex items-center justify-between">
    <div class="flex items-center gap-3">
      <span class="text-xs font-mono font-bold tracking-[0.2em] uppercase text-[#EDE4BE]" id="cart-drawer-title">
        TU BOLSA
      </span>
      <span
        id="cart-drawer-badge"
        class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-[#1c1c1c] text-[#8e8e8e] border border-[#2a2a2a]"
      >
        0 ITEMS
      </span>
    </div>

    <!-- Botón Cerrar Minimalista -->
    <button
      id="cart-close-btn"
      type="button"
      class="text-[#8e8e8e] hover:text-white p-1 rounded-md transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#EDE4BE]"
      aria-label="Cerrar bolsa"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Contenido de Items / Empty State -->
  <div id="cart-items-container" class="flex-1 overflow-y-auto px-6 py-6 space-y-4">
    <!-- Estado Vacío por defecto -->
    <div id="cart-empty-state" class="h-full flex flex-col items-center justify-center text-center py-16">
      <div class="w-12 h-12 rounded-full bg-[#161616] border border-[#262626] flex items-center justify-center text-[#555] mb-4">
        <Icon name="cart" size={20} />
      </div>
      <p class="font-heading text-xl text-[#EDE4BE] uppercase tracking-wider mb-1">
        TU BOLSA ESTÁ VACÍA
      </p>
      <p class="text-xs text-[#777] max-w-xs leading-relaxed mb-6 font-sans">
        Explora cajas selladas, sobres de colección y cartas exclusivas en preventa.
      </p>
      <a
        href="#paquetes"
        id="cart-explore-btn"
        class="inline-flex items-center justify-center px-6 py-2.5 rounded-full font-heading text-xs tracking-widest uppercase bg-[#EDE4BE] text-black hover:bg-white transition-all"
      >
        VER PRODUCTOS
      </a>
    </div>

    <!-- Lista dinámica de items -->
    <ul id="cart-items-list" class="divide-y divide-[#1c1c1c] hidden"></ul>
  </div>

  <!-- Footer del Carrito con Subtotal y Checkout -->
  <div class="p-6 border-t border-[#1f1f1f] bg-[#0c0c0c] flex flex-col gap-4">
    <div class="space-y-2">
      <div class="flex items-center justify-between text-xs text-[#8e8e8e] font-mono">
        <span>SUBTOTAL</span>
        <span id="cart-subtotal" class="text-white font-medium">$0 MXN</span>
      </div>
      <div class="flex items-center justify-between text-[11px] text-[#555] font-mono">
        <span>ENVÍO AÉREO / ASEGURADO</span>
        <span class="text-[#71B5F4]">CALCULADO EN CHECKOUT</span>
      </div>
    </div>

    <button
      id="cart-checkout-btn"
      type="button"
      class="w-full py-3.5 px-4 rounded-full font-heading text-base tracking-widest uppercase bg-[#EDE4BE] text-black hover:bg-white active:scale-[0.99] transition-all flex items-center justify-center gap-2 font-bold cursor-pointer disabled:opacity-40 disabled:pointer-events-none"
      disabled
    >
      <span>PROCEDER AL PAGO</span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </button>

    <div class="flex items-center justify-center gap-4 text-[10px] text-[#555] font-mono tracking-wider">
      <span>AUTENTICIDAD 100% GARANTIZADA</span>
      <span>•</span>
      <span>ENVÍO BLINDADO</span>
    </div>
  </div>
</aside>

<script>
  import { isCartOpen, cartItems, closeCart, removeFromCart } from '../../stores/cart';

  const overlay = document.getElementById('cart-overlay');
  const drawer = document.getElementById('cart-drawer');
  const closeBtn = document.getElementById('cart-close-btn');
  const exploreBtn = document.getElementById('cart-explore-btn');
  const emptyState = document.getElementById('cart-empty-state');
  const itemsList = document.getElementById('cart-items-list');
  const badgeEl = document.getElementById('cart-drawer-badge');
  const subtotalEl = document.getElementById('cart-subtotal');
  const checkoutBtn = document.getElementById('cart-checkout-btn') as HTMLButtonElement | null;

  // Sincronizar apertura/cierre de Drawer
  isCartOpen.subscribe((open) => {
    if (!drawer || !overlay) return;
    if (open) {
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      overlay.classList.add('opacity-100');
      drawer.classList.remove('translate-x-full');
      document.body.style.overflow = 'hidden';
    } else {
      overlay.classList.remove('opacity-100');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      drawer.classList.add('translate-x-full');
      document.body.style.overflow = '';
    }
  });

  const hide = () => closeCart();
  overlay?.addEventListener('click', hide);
  closeBtn?.addEventListener('click', hide);
  exploreBtn?.addEventListener('click', hide);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isCartOpen.get()) {
      closeCart();
    }
  });

  // Renderizar contenido dinámico
  cartItems.subscribe((items) => {
    const list = Object.values(items);
    const count = list.reduce((acc, curr) => acc + curr.quantity, 0);

    if (badgeEl) {
      badgeEl.textContent = `${count} ${count === 1 ? 'ITEM' : 'ITEMS'}`;
    }

    if (!emptyState || !itemsList || !subtotalEl || !checkoutBtn) return;

    if (list.length === 0) {
      emptyState.classList.remove('hidden');
      itemsList.classList.add('hidden');
      subtotalEl.textContent = '$0 MXN';
      checkoutBtn.disabled = true;
      return;
    }

    emptyState.classList.add('hidden');
    itemsList.classList.remove('hidden');
    checkoutBtn.disabled = false;

    const total = list.reduce((acc, item) => acc + item.priceMxn * item.quantity, 0);
    subtotalEl.textContent = new Intl.NumberFormat('es-MX', {
      style: 'currency',
      currency: 'MXN',
      maximumFractionDigits: 0
    }).format(total);

    itemsList.innerHTML = '';
    list.forEach((item) => {
      const li = document.createElement('li');
      li.className = 'py-4 flex items-center gap-4';
      li.innerHTML = `
        <div class="w-16 h-16 rounded-lg bg-[#141414] border border-[#222222] p-1 flex items-center justify-center shrink-0">
          <img src="${item.imageUrl || ''}" alt="${item.title}" class="max-w-full max-h-full object-contain" />
        </div>
        <div class="flex-1 min-w-0">
          <h4 class="font-heading text-base text-[#EDE4BE] truncate">${item.title}</h4>
          <p class="text-[11px] font-mono text-[#777]">${new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN', maximumFractionDigits: 0 }).format(item.priceMxn)} x ${item.quantity}</p>
        </div>
        <button
          type="button"
          data-remove-id="${item.id}"
          class="text-[#555] hover:text-[#FF4D57] p-1 transition-colors"
          title="Eliminar producto"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        </button>
      `;

      li.querySelector('[data-remove-id]')?.addEventListener('click', () => {
        removeFromCart(item.id);
      });

      itemsList.appendChild(li);
    });
  });
</script>
