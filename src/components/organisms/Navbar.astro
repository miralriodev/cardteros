---
import CardterosLogo from '../atoms/CardterosLogo.astro';
import Icon from '../atoms/Icon.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<header class={`sticky top-0 z-50 w-full bg-[#111111]/95 backdrop-blur-md border-b border-[#2a2a2a] transition-colors ${className}`}>
  <div class="max-w-7xl mx-auto px-6 lg:px-12 h-20 flex items-center justify-between">
    <!-- Navegación Izquierda -->
    <nav class="flex items-center gap-10" aria-label="Navegación principal izquierda">
      <a
        href="#drops"
        class="text-xs font-mono font-bold tracking-[0.25em] uppercase text-[#EDE4BE] hover:text-white transition-colors"
      >
        DROPS
      </a>
      <a
        href="#paquetes"
        class="text-xs font-mono font-bold tracking-[0.25em] uppercase text-[#A0A0A0] hover:text-[#EDE4BE] transition-colors"
      >
        STORE
      </a>
    </nav>

    <!-- Logo Central Vintage Béisbol Script -->
    <div class="flex items-center justify-center">
      <a href="/" class="focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#EDE4BE] rounded-sm" aria-label="Cardteros Inicio">
        <CardterosLogo size="lg" />
      </a>
    </div>

    <!-- Navegación Derecha -->
    <nav class="flex items-center gap-10" aria-label="Navegación principal derecha">
      <a
        href="#faq"
        class="text-xs font-mono font-bold tracking-[0.25em] uppercase text-[#A0A0A0] hover:text-[#EDE4BE] transition-colors"
      >
        FAQ
      </a>
      <a
        href="#new"
        class="text-xs font-mono font-bold tracking-[0.25em] uppercase text-[#A72027] hover:text-[#FF4D57] transition-colors flex items-center gap-2"
      >
        <span>NEW</span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#A72027] animate-pulse"></span>
      </a>

      <!-- Iconos de Acción Rápidos -->
      <div class="hidden sm:flex items-center gap-4 pl-4 border-l border-[#2e2e2e]">
        <button
          type="button"
          class="text-[#A0A0A0] hover:text-[#EDE4BE] transition-colors p-1"
          aria-label="Buscar coleccionables"
        >
          <Icon name="search" size={18} />
        </button>
        <button
          type="button"
          class="relative text-[#A0A0A0] hover:text-[#EDE4BE] transition-colors p-1"
          aria-label="Carrito de compras"
        >
          <Icon name="cart" size={18} />
          <span class="absolute -top-1.5 -right-1.5 w-4 h-4 bg-[#A72027] text-white text-[10px] font-bold rounded-full flex items-center justify-center">
            0
          </span>
        </button>
      </div>
    </nav>
  </div>
</header>
