---
import CardterosLogo from '../atoms/CardterosLogo.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<header class={`sticky top-0 z-40 w-full bg-[#111111]/95 backdrop-blur-md border-b border-[#222222] transition-colors ${className}`}>
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-12 h-16 sm:h-20 flex items-center justify-between">
    
    <!-- =========================================================================
         1. VISTA MÓVIL PREMIUM MINIMALISTA
         - Logo mini a la izquierda
         - Solo 2 iconos ordenados a la derecha (Bolsa de compra + Menú)
         ========================================================================= -->
    <div class="flex sm:hidden items-center justify-between w-full">
      <!-- Logo Mini Izquierda -->
      <a href="/" class="flex items-center focus-visible:outline-none" aria-label="Cardteros Inicio">
        <img
          src="/assets/cardteros_logo.png"
          alt="Cardteros"
          class="h-7 w-auto object-contain filter drop-shadow-sm"
          loading="eager"
        />
      </a>

      <!-- Iconos Derecha (Carrito + Hamburguesa de 2 líneas minimalista) -->
      <div class="flex items-center gap-4">
        <!-- Bolsa de Compra Móvil -->
        <button
          id="mobile-cart-btn"
          type="button"
          class="relative text-[#EDE4BE] hover:text-white p-1.5 transition-colors cursor-pointer focus-visible:outline-none"
          aria-label="Abrir bolsa de compra"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span
            id="mobile-cart-count"
            class="absolute -top-1 -right-1 w-4 h-4 bg-[#A72027] text-white text-[9px] font-mono font-bold rounded-full flex items-center justify-center scale-0 transition-transform duration-200"
          >
            0
          </span>
        </button>

        <!-- Botón Menú Hamburguesa Minimalista de 2 Líneas -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="text-[#EDE4BE] hover:text-white p-1.5 transition-colors cursor-pointer focus-visible:outline-none"
          aria-label="Menú"
          aria-expanded="false"
        >
          <div class="w-5 h-3.5 flex flex-col justify-between">
            <span class="w-full h-[1.5px] bg-[#EDE4BE] transition-transform duration-300 origin-center" id="menu-bar-1"></span>
            <span class="w-3/4 self-end h-[1.5px] bg-[#EDE4BE] transition-transform duration-300 origin-center" id="menu-bar-2"></span>
          </div>
        </button>
      </div>
    </div>

    <!-- =========================================================================
         2. VISTA TABLET & DESKTOP (Ultra-Limpia, Sin Iconos Ruidosos ni Flechas)
         ========================================================================= -->
    <nav class="hidden sm:flex items-center gap-10" aria-label="Navegación principal izquierda">
      <a
        href="#drops"
        class="text-xs font-mono font-semibold tracking-[0.28em] uppercase text-[#EDE4BE] hover:text-white transition-colors py-2 relative group"
      >
        <span>DROPS</span>
        <span class="absolute bottom-0 left-0 w-0 h-[1.5px] bg-[#EDE4BE] transition-all duration-300 group-hover:w-full"></span>
      </a>
      <a
        href="#paquetes"
        class="text-xs font-mono font-semibold tracking-[0.28em] uppercase text-[#A0A0A0] hover:text-[#EDE4BE] transition-colors py-2 relative group"
      >
        <span>STORE</span>
        <span class="absolute bottom-0 left-0 w-0 h-[1.5px] bg-[#EDE4BE] transition-all duration-300 group-hover:w-full"></span>
      </a>
    </nav>

    <!-- Logo Central Vintage Béisbol Script (Desktop) -->
    <div class="hidden sm:flex items-center justify-center">
      <a href="/" class="focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#EDE4BE] rounded-sm transition-transform hover:scale-105" aria-label="Cardteros Inicio">
        <CardterosLogo size="lg" />
      </a>
    </div>

    <!-- Navegación Derecha (Desktop) -->
    <nav class="hidden sm:flex items-center gap-10" aria-label="Navegación principal derecha">
      <a
        href="#faq"
        class="text-xs font-mono font-semibold tracking-[0.28em] uppercase text-[#A0A0A0] hover:text-[#EDE4BE] transition-colors py-2"
      >
        FAQ
      </a>
      <a
        href="#drops"
        class="text-xs font-mono font-semibold tracking-[0.28em] uppercase text-[#A72027] hover:text-[#FF4D57] transition-colors py-2 flex items-center gap-2"
      >
        <span>NEW</span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#A72027] animate-pulse"></span>
      </a>

      <!-- Iconos de Acción Rápidos Minimalistas -->
      <div class="flex items-center gap-4 pl-6 border-l border-[#262626]">
        <button
          id="navbar-cart-btn"
          type="button"
          class="relative text-[#A0A0A0] hover:text-[#EDE4BE] transition-colors p-1.5 cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#EDE4BE] rounded-md"
          aria-label="Abrir carrito de compras"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span
            id="navbar-cart-count"
            class="absolute -top-1 -right-1 w-4 h-4 bg-[#A72027] text-white text-[9px] font-mono font-bold rounded-full flex items-center justify-center scale-0 transition-transform duration-200"
          >
            0
          </span>
        </button>
      </div>
    </nav>
  </div>

  <!-- Panel Desplegable Móvil Ultra-Premium (Full Blur Curtain sin emojis) -->
  <div
    id="mobile-menu-drawer"
    class="sm:hidden fixed inset-x-0 top-16 bg-[#0a0a0a]/95 border-b border-[#222222] backdrop-blur-2xl px-6 py-8 transition-all duration-400 ease-[cubic-bezier(0.16,1,0.3,1)] -translate-y-full opacity-0 pointer-events-none shadow-[0_25px_60px_rgba(0,0,0,0.95)]"
  >
    <div class="flex flex-col gap-5 text-left font-mono">
      <a href="#drops" class="text-xs font-semibold tracking-[0.3em] uppercase text-[#EDE4BE] hover:text-white py-2.5 border-b border-[#1a1a1a] mobile-menu-link flex items-center justify-between">
        <span>DROPS RECIENTES</span>
        <span class="text-[10px] text-[#A72027] tracking-widest">LIVE</span>
      </a>
      <a href="#paquetes" class="text-xs font-semibold tracking-[0.3em] uppercase text-[#EDE4BE] hover:text-white py-2.5 border-b border-[#1a1a1a] mobile-menu-link flex items-center justify-between">
        <span>TIENDA / CAJAS</span>
        <span class="text-[10px] text-[#555] tracking-widest">SEALED</span>
      </a>
      <a href="#acerca" class="text-xs font-semibold tracking-[0.3em] uppercase text-[#A0A0A0] hover:text-white py-2.5 border-b border-[#1a1a1a] mobile-menu-link">
        <span>CÓMO FUNCIONA</span>
      </a>
      <a href="#faq" class="text-xs font-semibold tracking-[0.3em] uppercase text-[#A0A0A0] hover:text-white py-2.5 mobile-menu-link">
        <span>PREGUNTAS FRECUENTES</span>
      </a>
    </div>
  </div>
</header>

<script>
  import { openCart, cartItems } from '../../stores/cart';

  const cartBtn = document.getElementById('navbar-cart-btn');
  const countBadge = document.getElementById('navbar-cart-count');
  const mobileCartBtn = document.getElementById('mobile-cart-btn');
  const mobileCountBadge = document.getElementById('mobile-cart-count');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenuDrawer = document.getElementById('mobile-menu-drawer');
  const mobileLinks = document.querySelectorAll('.mobile-menu-link');
  const bar1 = document.getElementById('menu-bar-1');
  const bar2 = document.getElementById('menu-bar-2');

  // Trigger Carrito
  cartBtn?.addEventListener('click', () => openCart());
  mobileCartBtn?.addEventListener('click', () => openCart());

  // Toggle Menú Hamburguesa Minimalista
  let isMenuOpen = false;
  function toggleMobileMenu() {
    isMenuOpen = !isMenuOpen;
    if (mobileMenuDrawer && mobileMenuBtn) {
      if (isMenuOpen) {
        mobileMenuDrawer.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none');
        mobileMenuDrawer.classList.add('translate-y-0', 'opacity-100');
        mobileMenuBtn.setAttribute('aria-expanded', 'true');
        if (bar1 && bar2) {
          bar1.style.transform = 'translateY(6px) rotate(45deg)';
          bar2.style.transform = 'translateY(-6px) rotate(-45deg)';
          bar2.style.width = '100%';
        }
      } else {
        mobileMenuDrawer.classList.remove('translate-y-0', 'opacity-100');
        mobileMenuDrawer.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none');
        mobileMenuBtn.setAttribute('aria-expanded', 'false');
        if (bar1 && bar2) {
          bar1.style.transform = 'none';
          bar2.style.transform = 'none';
          bar2.style.width = '75%';
        }
      }
    }
  }

  mobileMenuBtn?.addEventListener('click', toggleMobileMenu);

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      if (isMenuOpen) toggleMobileMenu();
    });
  });

  // Contador de Carrito Sincronizado
  cartItems.subscribe((items) => {
    const totalCount = Object.values(items).reduce((acc, curr) => acc + curr.quantity, 0);
    const badges = [countBadge, mobileCountBadge];

    badges.forEach((badge) => {
      if (badge) {
        badge.textContent = totalCount.toString();
        if (totalCount > 0) {
          badge.classList.remove('scale-0');
          badge.classList.add('scale-100');
        } else {
          badge.classList.remove('scale-100');
          badge.classList.add('scale-0');
        }
      }
    });
  });
</script>
