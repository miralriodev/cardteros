---
import CardterosLogo from '../atoms/CardterosLogo.astro';
import Icon from '../atoms/Icon.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<header class={`sticky top-0 z-40 w-full bg-[#111111]/95 backdrop-blur-md border-b border-[#2a2a2a] transition-colors ${className}`}>
  <div class="max-w-7xl mx-auto px-6 lg:px-12 h-20 flex items-center justify-between">
    <!-- Navegación Izquierda con Dropdown Menus -->
    <nav class="flex items-center gap-8" aria-label="Navegación principal izquierda">
      <!-- 1. Dropdown: DROPS -->
      <div class="relative group">
        <button
          type="button"
          class="flex items-center gap-1.5 text-xs font-mono font-bold tracking-[0.25em] uppercase text-[#EDE4BE] group-hover:text-white transition-colors py-2 focus-visible:outline-none"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>DROPS</span>
          <svg class="w-3 h-3 text-[#8e8e8e] group-hover:text-[#EDE4BE] transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown Menu Panel -->
        <div class="absolute left-0 top-full pt-2 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
          <div class="w-56 rounded-xl bg-[#0e0e0e] border border-[#2a2a2a] p-2 shadow-2xl backdrop-blur-md">
            <a href="#drops" class="block px-3 py-2 rounded-lg text-xs font-mono text-[#C4C4C4] hover:text-[#EDE4BE] hover:bg-[#1a1a1a] transition-colors">
              🔥 LIVE BREAKS DE HOY
            </a>
            <a href="#drops" class="block px-3 py-2 rounded-lg text-xs font-mono text-[#C4C4C4] hover:text-[#EDE4BE] hover:bg-[#1a1a1a] transition-colors">
              🏆 GRADED SLABS 1/1
            </a>
            <a href="#drops" class="block px-3 py-2 rounded-lg text-xs font-mono text-[#C4C4C4] hover:text-[#EDE4BE] hover:bg-[#1a1a1a] transition-colors">
              📦 PREVENTAS LIMITADAS
            </a>
          </div>
        </div>
      </div>

      <!-- 2. Dropdown: STORE -->
      <div class="relative group">
        <button
          type="button"
          class="flex items-center gap-1.5 text-xs font-mono font-bold tracking-[0.25em] uppercase text-[#A0A0A0] group-hover:text-[#EDE4BE] transition-colors py-2 focus-visible:outline-none"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>STORE</span>
          <svg class="w-3 h-3 text-[#8e8e8e] group-hover:text-[#EDE4BE] transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown Menu Panel -->
        <div class="absolute left-0 top-full pt-2 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
          <div class="w-60 rounded-xl bg-[#0e0e0e] border border-[#2a2a2a] p-2 shadow-2xl backdrop-blur-md">
            <a href="#paquetes" class="block px-3 py-2 rounded-lg text-xs font-mono text-[#C4C4C4] hover:text-[#EDE4BE] hover:bg-[#1a1a1a] transition-colors">
              🏈 TOPPS RESURGENCE
            </a>
            <a href="#paquetes" class="block px-3 py-2 rounded-lg text-xs font-mono text-[#C4C4C4] hover:text-[#EDE4BE] hover:bg-[#1a1a1a] transition-colors">
              ⚽ TOPPS CHROME UEFA
            </a>
            <a href="#paquetes" class="block px-3 py-2 rounded-lg text-xs font-mono text-[#C4C4C4] hover:text-[#EDE4BE] hover:bg-[#1a1a1a] transition-colors">
              🏀 PANINI PRIZM NBA
            </a>
            <div class="my-1 border-t border-[#222222]"></div>
            <a href="#paquetes" class="block px-3 py-2 rounded-lg text-xs font-mono text-[#EDE4BE] hover:bg-[#1a1a1a] transition-colors font-bold">
              VER TODAS LAS CAJAS →
            </a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Logo Central Vintage Béisbol Script -->
    <div class="flex items-center justify-center">
      <a href="/" class="focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#EDE4BE] rounded-sm transition-transform hover:scale-105" aria-label="Cardteros Inicio">
        <CardterosLogo size="lg" />
      </a>
    </div>

    <!-- Navegación Derecha -->
    <nav class="flex items-center gap-8" aria-label="Navegación principal derecha">
      <a
        href="#faq"
        class="text-xs font-mono font-bold tracking-[0.25em] uppercase text-[#A0A0A0] hover:text-[#EDE4BE] transition-colors"
      >
        FAQ
      </a>
      <a
        href="#drops"
        class="text-xs font-mono font-bold tracking-[0.25em] uppercase text-[#A72027] hover:text-[#FF4D57] transition-colors flex items-center gap-2"
      >
        <span>NEW</span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#A72027] animate-pulse"></span>
      </a>

      <!-- Iconos de Acción Rápidos -->
      <div class="flex items-center gap-4 pl-4 border-l border-[#2e2e2e]">
        <button
          type="button"
          class="text-[#A0A0A0] hover:text-[#EDE4BE] transition-colors p-1 cursor-pointer"
          aria-label="Buscar coleccionables"
        >
          <Icon name="search" size={18} />
        </button>

        <!-- Botón Trigger Carrito (Abre CartDrawer) -->
        <button
          id="navbar-cart-btn"
          type="button"
          class="relative text-[#A0A0A0] hover:text-[#EDE4BE] transition-colors p-1 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#EDE4BE] rounded-md"
          aria-label="Abrir carrito de compras"
        >
          <Icon name="cart" size={18} />
          <span
            id="navbar-cart-count"
            class="absolute -top-1.5 -right-1.5 w-4 h-4 bg-[#A72027] text-white text-[9px] font-mono font-bold rounded-full flex items-center justify-center scale-0 transition-transform duration-200"
          >
            0
          </span>
        </button>
      </div>
    </nav>
  </div>
</header>

<script>
  import { openCart, cartItems } from '../../stores/cart';

  const cartBtn = document.getElementById('navbar-cart-btn');
  const countBadge = document.getElementById('navbar-cart-count');

  cartBtn?.addEventListener('click', () => {
    openCart();
  });

  cartItems.subscribe((items) => {
    const totalCount = Object.values(items).reduce((acc, curr) => acc + curr.quantity, 0);
    if (countBadge) {
      countBadge.textContent = totalCount.toString();
      if (totalCount > 0) {
        countBadge.classList.remove('scale-0');
        countBadge.classList.add('scale-100');
      } else {
        countBadge.classList.remove('scale-100');
        countBadge.classList.add('scale-0');
      }
    }
  });
</script>
