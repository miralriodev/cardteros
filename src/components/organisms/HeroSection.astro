---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<section class={`relative w-full overflow-hidden bg-[#111111] pt-14 pb-28 md:pt-20 md:pb-36 border-b border-[#2c2c2c] ${className}`}>
  <!-- Destello / Spotlight Ambiental Central (Figma Vibe) -->
  <div class="absolute inset-0 pointer-events-none flex items-center justify-center">
    <div class="w-[600px] h-[600px] bg-[#EDE4BE]/5 rounded-full blur-[160px] -translate-y-20"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[450px] h-[450px] bg-[#A72027]/10 rounded-full blur-[140px]"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center text-center">
    <!-- Título Masivo en Bebas Neue (Figma Exact Match - Optimizado iPhone/Móvil) -->
    <h1 class="font-heading text-6xl sm:text-8xl md:text-9xl lg:text-[150px] tracking-wide text-[#EDE4BE] uppercase leading-[0.88] select-none mb-3 drop-shadow-sm px-2">
      YA LLEGAMOS
    </h1>

    <!-- Subtítulo con Puntos de Separación -->
    <p class="text-[11px] sm:text-sm md:text-base font-mono font-medium tracking-[0.25em] sm:tracking-[0.35em] text-[#C4C4C4] uppercase mb-8 sm:mb-16 select-none">
      BREAKS • CAJAS • SLAPS
    </p>

    <!-- =========================================================================
         OPCIÓN 1: MÓVIL / iPHONE (SCROLL-DRIVEN 3D DECK CASSETTE / FLUID TILT)
         Variación de última generación: Las cartas inician en deck apilado y al
         scrollear se abren en cascada con inclinación giroscópica y desaceleración.
         ========================================================================= -->
    <div id="mobile-hero-deck" class="relative w-full max-w-sm mx-auto flex sm:hidden flex-col items-center pt-2 pb-8 overflow-visible select-none">
      <div class="relative w-full h-[330px] flex items-center justify-center">
        <!-- 1. Carta Trasera Izquierda (NBA) -->
        <div
          id="deck-card-1"
          class="absolute w-[200px] transition-transform duration-100 ease-out will-change-transform cursor-pointer drop-shadow-[0_15px_30px_rgba(0,0,0,0.92)]"
          style="transform: translate3d(-24px, 18px, 0) rotate(-8deg) scale(0.92); z-index: 10;"
        >
          <img
            src="/src/assets/nbahero.png"
            alt="Carta coleccionable NBA Basketball Gold Refractor"
            class="w-full h-auto object-contain rounded-2xl"
            loading="eager"
          />
        </div>

        <!-- 2. Carta Central (Haaland - Frente y elevada) -->
        <div
          id="deck-card-2"
          class="absolute w-[215px] transition-transform duration-100 ease-out will-change-transform cursor-pointer drop-shadow-[0_25px_50px_rgba(0,0,0,0.98)]"
          style="transform: translate3d(0, 0, 30px) rotate(0deg) scale(1.05); z-index: 30;"
        >
          <img
            src="/src/assets/herohaland.png"
            alt="Carta coleccionable Erling Haaland Goal King Chrome Refractor"
            class="w-full h-auto object-contain rounded-2xl"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <!-- 3. Carta Trasera Derecha (Josh Allen) -->
        <div
          id="deck-card-3"
          class="absolute w-[200px] transition-transform duration-100 ease-out will-change-transform cursor-pointer drop-shadow-[0_15px_30px_rgba(0,0,0,0.92)]"
          style="transform: translate3d(24px, 18px, 0) rotate(8deg) scale(0.92); z-index: 10;"
        >
          <img
            src="/src/assets/joshallenhero.png"
            alt="Carta coleccionable Buffalo Bills Josh Allen Prizm"
            class="w-full h-auto object-contain rounded-2xl"
            loading="eager"
          />
        </div>
      </div>
    </div>

    <!-- =========================================================================
         OPCIÓN 2: TABLET Y DESKTOP (ABANICO 3D AMPLIO Y EXPANDIDO)
         ========================================================================= -->
    <div class="hidden sm:flex relative w-full max-w-4xl mx-auto items-center justify-center pt-2 pb-6 perspective-hero overflow-visible">
      <div class="relative flex items-center justify-center w-full min-h-[440px] md:min-h-[520px]">
        
        <!-- 1. Carta Izquierda: Jugador NBA (Crecida a w-[270px] md:w-[325px]) -->
        <div class="absolute sm:left-2 md:left-6 sm:top-6 w-[270px] md:w-[325px] hero-fan-left cursor-pointer group">
          <img
            src="/src/assets/nbahero.png"
            alt="Carta coleccionable NBA Basketball Gold Refractor"
            class="w-full h-auto object-contain rounded-2xl group-hover:scale-105 transition-all duration-500 drop-shadow-[0_20px_40px_rgba(0,0,0,0.92)]"
            loading="eager"
          />
        </div>

        <!-- 2. Carta Central: Erling Haaland (Frente, Elevada y Destacada) -->
        <div class="relative w-[280px] md:w-[350px] hero-fan-center cursor-pointer group">
          <img
            src="/src/assets/herohaland.png"
            alt="Carta coleccionable Erling Haaland Goal King Chrome Refractor"
            class="w-full h-auto object-contain rounded-2xl group-hover:scale-105 transition-all duration-500 drop-shadow-[0_30px_60px_rgba(0,0,0,0.98)]"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <!-- 3. Carta Derecha: Josh Allen (Crecida a w-[270px] md:w-[325px]) -->
        <div class="absolute sm:right-2 md:right-6 sm:top-6 w-[270px] md:w-[325px] hero-fan-right cursor-pointer group">
          <img
            src="/src/assets/joshallenhero.png"
            alt="Carta coleccionable Buffalo Bills Josh Allen Prizm"
            class="w-full h-auto object-contain rounded-2xl group-hover:scale-105 transition-all duration-500 drop-shadow-[0_20px_40px_rgba(0,0,0,0.92)]"
            loading="eager"
          />
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  // Animación reactiva ultra-suave al scroll de iPhone / iOS
  const deck1 = document.getElementById('deck-card-1');
  const deck2 = document.getElementById('deck-card-2');
  const deck3 = document.getElementById('deck-card-3');
  const mobileHero = document.getElementById('mobile-hero-deck');

  if (mobileHero && deck1 && deck2 && deck3) {
    let ticking = false;

    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollY = window.scrollY;
          // Progreso de apertura según el scroll inicial (0 a 300px)
          const progress = Math.min(Math.max(scrollY / 240, 0), 1);

          // Interpolación de posiciones:
          // Al scrollear, las cartas se separan lateralmente, flotan y abren su abanico de forma cinematográfica
          const tx1 = -24 - (progress * 70); // Desplaza a la izquierda hasta -94px
          const ty1 = 18 + (progress * 15);
          const rot1 = -8 - (progress * 12); // Rota de -8deg a -20deg
          const scale1 = 0.92 + (progress * 0.05);

          const tx3 = 24 + (progress * 70);  // Desplaza a la derecha hasta +94px
          const ty3 = 18 + (progress * 15);
          const rot3 = 8 + (progress * 12);   // Rota de 8deg a +20deg
          const scale3 = 0.92 + (progress * 0.05);

          const ty2 = -(progress * 28);       // La carta central se eleva hacia arriba
          const scale2 = 1.05 + (progress * 0.06);

          deck1.style.transform = `translate3d(${tx1}px, ${ty1}px, 0) rotate(${rot1}deg) scale(${scale1})`;
          deck3.style.transform = `translate3d(${tx3}px, ${ty3}px, 0) rotate(${rot3}deg) scale(${scale3})`;
          deck2.style.transform = `translate3d(0, ${ty2}px, 30px) rotate(0deg) scale(${scale2})`;

          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    // Disparar una vez inicial
    onScroll();
  }
</script>
