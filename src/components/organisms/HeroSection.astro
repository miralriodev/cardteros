---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<section class={`relative w-full overflow-hidden bg-[#111111] pt-14 pb-28 md:pt-20 md:pb-36 border-b border-[#2c2c2c] ${className}`}>
  <!-- Destello / Spotlight Ambiental Central (Figma Vibe) -->
  <div class="absolute inset-0 pointer-events-none flex items-center justify-center">
    <div class="w-[600px] h-[600px] bg-[#EDE4BE]/5 rounded-full blur-[160px] -translate-y-20"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[450px] h-[450px] bg-[#A72027]/10 rounded-full blur-[140px]"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center text-center">
    <!-- Título Masivo en Bebas Neue (Figma Exact Match - Optimizado iPhone/Móvil) -->
    <h1 class="font-heading text-6xl sm:text-8xl md:text-9xl lg:text-[150px] tracking-wide text-[#EDE4BE] uppercase leading-[0.88] select-none mb-3 drop-shadow-sm px-2">
      YA LLEGAMOS
    </h1>

    <!-- Subtítulo con Puntos de Separación -->
    <p class="text-[11px] sm:text-sm md:text-base font-mono font-medium tracking-[0.25em] sm:tracking-[0.35em] text-[#C4C4C4] uppercase mb-8 sm:mb-16 select-none">
      BREAKS • CAJAS • SLAPS
    </p>

    <!-- Showcase Visual de Cartas en Abanico 3D (Fluid para iPhone) -->
    <div class="relative w-full max-w-4xl mx-auto flex items-center justify-center pt-2 pb-6 perspective-hero overflow-visible">
      <div class="relative flex items-center justify-center w-full min-h-[300px] sm:min-h-[440px] md:min-h-[520px]">
        
        <!-- 1. Carta Izquierda: Jugador NBA (Inclinada -14deg, Sin contenedor/borde extra) -->
        <div class="absolute -left-1 sm:left-6 md:left-14 top-4 sm:top-10 w-[140px] sm:w-[220px] md:w-[275px] hero-fan-left cursor-pointer group">
          <img
            src="/src/assets/nbahero.png"
            alt="Carta coleccionable NBA Basketball Gold Refractor"
            class="w-full h-auto object-contain rounded-2xl group-hover:scale-105 transition-all duration-500 drop-shadow-[0_15px_30px_rgba(0,0,0,0.9)]"
            loading="eager"
          />
        </div>

        <!-- 2. Carta Central: Erling Haaland (Frente, Elevada y Destacada, Sin contenedor/borde extra) -->
        <div class="relative w-[170px] sm:w-[260px] md:w-[335px] hero-fan-center cursor-pointer group">
          <img
            src="/src/assets/herohaland.png"
            alt="Carta coleccionable Erling Haaland Goal King Chrome Refractor"
            class="w-full h-auto object-contain rounded-2xl group-hover:scale-105 transition-all duration-500 drop-shadow-[0_25px_50px_rgba(0,0,0,0.95)]"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <!-- 3. Carta Derecha: Josh Allen (Inclinada +14deg, Sin contenedor/borde extra) -->
        <div class="absolute -right-1 sm:right-6 md:right-14 top-4 sm:top-10 w-[140px] sm:w-[220px] md:w-[275px] hero-fan-right cursor-pointer group">
          <img
            src="/src/assets/joshallenhero.png"
            alt="Carta coleccionable Buffalo Bills Josh Allen Prizm"
            class="w-full h-auto object-contain rounded-2xl group-hover:scale-105 transition-all duration-500 drop-shadow-[0_15px_30px_rgba(0,0,0,0.9)]"
            loading="eager"
          />
        </div>

      </div>
    </div>
  </div>
</section>
