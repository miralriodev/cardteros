---
import MainLayout from '../components/templates/MainLayout.astro';
---

<MainLayout
  title="CARDTEROS - Tu Bolsa de Compra | Detalle y Resumen de Pedido"
  description="Revisa tus cartas deportivas, cajas selladas y spots de breaks en vivo antes de proceder al pago protegido con autenticidad garantizada y envío blindado."
>
  <div class="w-full bg-[#111111] min-h-screen py-10 sm:py-16">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-12">
      
      <!-- Breadcrumbs de Navegación -->
      <nav class="flex items-center gap-2 text-xs font-mono tracking-wider text-[#777777] mb-6 uppercase" aria-label="Ruta de navegación">
        <a href="/" class="hover:text-[#EDE4BE] transition-colors">INICIO</a>
        <span>/</span>
        <a href="/store" class="hover:text-[#EDE4BE] transition-colors">TIENDA</a>
        <span>/</span>
        <span class="text-[#EDE4BE]">BOLSA DE COMPRA</span>
      </nav>

      <!-- Título Principal de la Página -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 sm:mb-12 border-b border-[#222222] pb-6">
        <div>
          <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl text-[#EDE4BE] tracking-tight uppercase leading-none">
            DETALLE DE TU BOLSA
          </h1>
          <p class="text-xs sm:text-sm font-mono text-[#8E8E8E] tracking-widest uppercase mt-2">
            REVISA TUS PRODUCTOS Y SELECCIONA TU MODALIDAD DE ENTREGA
          </p>
        </div>

        <a
          href="/store"
          class="inline-flex items-center gap-2 text-xs font-mono text-[#EDE4BE] hover:text-white uppercase transition-colors"
        >
          <span>← SEGUIR COMPRANDO</span>
        </a>
      </div>

      <!-- Estado Vacío en Página Completa (Oculto dinámicamente) -->
      <div
        id="full-cart-empty"
        class="hidden py-24 text-center rounded-3xl bg-[#141414] border border-[#222222] p-8 max-w-2xl mx-auto"
      >
        <div class="w-20 h-20 rounded-full bg-[#1c1c1c] border border-[#2a2a2a] flex items-center justify-center text-4xl mx-auto mb-6">
          🛒
        </div>
        <h2 class="font-heading text-3xl text-[#EDE4BE] uppercase tracking-wide mb-2">
          TU BOLSA ESTÁ VACÍA
        </h2>
        <p class="text-xs font-mono text-[#888888] max-w-md mx-auto leading-relaxed mb-8">
          Aún no has añadido cajas, sobres o cartas graduadas a tu pedido. Explora nuestro catálogo con piezas de colección de alta demanda.
        </p>
        <a
          href="/store"
          class="inline-flex items-center justify-center px-8 py-3.5 rounded-full font-heading text-sm tracking-widest uppercase bg-[#EDE4BE] text-black hover:bg-white active:scale-95 transition-all shadow-lg font-bold"
        >
          EXPLORAR CATÁLOGO OFICIAL
        </a>
      </div>

      <!-- Layout de Dos Columnas de la Bolsa (Contenido cuando hay items) -->
      <div id="full-cart-content" class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-12 items-start">
        
        <!-- Columna Izquierda: Tabla/Lista de Items y Modalidad de Entrega (8 Cols) -->
        <div class="lg:col-span-7 xl:col-span-8 space-y-8">
          
          <!-- Contenedor de Items con Cabecera -->
          <div class="rounded-2xl bg-[#141414] border border-[#222222] p-5 sm:p-7 overflow-hidden">
            <div class="flex items-center justify-between pb-4 border-b border-[#222222] mb-4">
              <span class="text-xs font-mono font-bold tracking-[0.2em] uppercase text-[#EDE4BE]">
                ARTÍCULOS SELECCIONADOS
              </span>
              <span id="full-cart-items-count" class="text-xs font-mono text-[#8E8E8E]">
                0 ITEMS
              </span>
            </div>

            <!-- Lista de Items Renderizada Dinámicamente -->
            <ul id="full-cart-items-list" class="divide-y divide-[#202020]" role="list"></ul>
          </div>

          <!-- Selección de Modalidad de Fulfillment de Coleccionismo -->
          <div class="rounded-2xl bg-[#141414] border border-[#222222] p-5 sm:p-7">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xs font-mono font-bold tracking-[0.2em] uppercase text-[#EDE4BE]">
                MODALIDAD DE ENTREGA / MANEJO DE CAJAS
              </span>
              <span class="px-2 py-0.5 rounded-full bg-[#1c1c1c] text-emerald-400 border border-emerald-500/30 text-[10px] font-mono">
                OFICIAL
              </span>
            </div>
            <p class="text-xs font-mono text-[#777] mb-5">
              En CARDTEROS puedes recibir tus cajas selladas en tu domicilio o pedir que las abramos en vivo durante el próximo stream oficial.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Opción 1: Envío Sellado -->
              <label class="relative flex flex-col p-4 rounded-xl border-2 border-[#EDE4BE] bg-[#1a1a1a] cursor-pointer transition-all option-fulfillment-card" id="card-mode-sealed">
                <input type="radio" name="page-fulfillment" value="ship_sealed" class="sr-only" checked />
                <div class="flex items-center justify-between mb-2">
                  <span class="font-heading text-lg text-[#EDE4BE] tracking-wide uppercase flex items-center gap-2">
                    <span>📦</span>
                    <span>ENVÍO SELLADO</span>
                  </span>
                  <span class="w-4 h-4 rounded-full border-2 border-[#EDE4BE] bg-[#EDE4BE] flex items-center justify-center">
                    <span class="w-1.5 h-1.5 rounded-full bg-black"></span>
                  </span>
                </div>
                <p class="text-xs text-[#A0A0A0] leading-relaxed">
                  Recibe tus cajas 100% selladas de fábrica con precintos intactos y embalaje reforzado multicapa.
                </p>
              </label>

              <!-- Opción 2: Rip on Stream -->
              <label class="relative flex flex-col p-4 rounded-xl border border-[#2a2a2a] bg-[#121212] cursor-pointer hover:border-[#444] transition-all opacity-80 hover:opacity-100 option-fulfillment-card" id="card-mode-stream">
                <input type="radio" name="page-fulfillment" value="rip_on_stream" class="sr-only" />
                <div class="flex items-center justify-between mb-2">
                  <span class="font-heading text-lg text-[#EDE4BE] tracking-wide uppercase flex items-center gap-2">
                    <span>📺</span>
                    <span>ABRIR EN VIVO (RIP IT)</span>
                  </span>
                  <span class="w-4 h-4 rounded-full border-2 border-[#555] flex items-center justify-center"></span>
                </div>
                <p class="text-xs text-[#A0A0A0] leading-relaxed">
                  Abrimos tus sobres en YouTube/TikTok oficial. Tus hits van en penny sleeves y top loaders protectores.
                </p>
              </label>
            </div>
          </div>

          <!-- Información de Garantía y Políticas de Colección -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
            <div class="p-4 rounded-xl bg-[#141414] border border-[#222222]">
              <span class="text-xl mb-1 block">🛡️</span>
              <h4 class="font-heading text-sm text-[#EDE4BE] tracking-wider uppercase mb-1">AUTENTICIDAD</h4>
              <p class="text-[11px] font-mono text-[#777] leading-tight">Distribuidor autorizado y productos verificados de fábrica.</p>
            </div>
            <div class="p-4 rounded-xl bg-[#141414] border border-[#222222]">
              <span class="text-xl mb-1 block">✈️</span>
              <h4 class="font-heading text-sm text-[#EDE4BE] tracking-wider uppercase mb-1">ENVÍO ASEGURADO</h4>
              <p class="text-[11px] font-mono text-[#777] leading-tight">Cobertura total contra daños o extravío con guía rastreada.</p>
            </div>
            <div class="p-4 rounded-xl bg-[#141414] border border-[#222222]">
              <span class="text-xl mb-1 block">🔒</span>
              <h4 class="font-heading text-sm text-[#EDE4BE] tracking-wider uppercase mb-1">PAGO SEGURO</h4>
              <p class="text-[11px] font-mono text-[#777] leading-tight">Encriptación SSL bancaria en todas las transacciones.</p>
            </div>
          </div>
        </div>

        <!-- Columna Derecha: Tarjeta de Resumen de Pedido Sticky (4 Cols) -->
        <div class="lg:col-span-5 xl:col-span-4 sticky top-24 space-y-6">
          <div class="rounded-2xl bg-[#141414] border border-[#222222] p-6 shadow-2xl space-y-6">
            <h2 class="font-heading text-2xl text-[#EDE4BE] tracking-wide uppercase border-b border-[#222222] pb-4">
              RESUMEN DEL PEDIDO
            </h2>

            <!-- Desglose Financiero -->
            <div class="space-y-3 font-mono text-xs">
              <div class="flex items-center justify-between text-[#8E8E8E]">
                <span>SUBTOTAL</span>
                <span id="page-cart-subtotal" class="text-white font-medium">$0 MXN</span>
              </div>

              <!-- Fila Descuento -->
              <div id="page-cart-discount-row" class="hidden items-center justify-between text-emerald-400">
                <span id="page-cart-discount-label">DESCUENTO</span>
                <span id="page-cart-discount-value">-$0 MXN</span>
              </div>

              <!-- Envío -->
              <div class="flex items-center justify-between text-[#8E8E8E]">
                <span>ENVÍO BLINDADO</span>
                <span id="page-cart-shipping" class="text-emerald-400 font-bold">GRATIS</span>
              </div>

              <div class="flex items-center justify-between text-[#666] text-[11px]">
                <span>SEGURO DE VALOR DECLARADO</span>
                <span class="text-[#8E8E8E]">INCLUIDO (100%)</span>
              </div>

              <!-- Total General -->
              <div class="pt-4 border-t border-[#222222] flex items-baseline justify-between">
                <div>
                  <span class="text-xs font-bold text-[#EDE4BE] tracking-widest block uppercase">TOTAL A PAGAR</span>
                  <span class="text-[10px] text-[#666] uppercase">IMPUESTOS INCLUIDOS</span>
                </div>
                <span id="page-cart-total" class="font-heading text-3xl sm:text-4xl text-[#EDE4BE] tracking-tight">
                  $0 MXN
                </span>
              </div>
            </div>

            <!-- Cupón de Descuento -->
            <div class="pt-4 border-t border-[#222222]">
              <span class="text-[11px] font-mono text-[#8E8E8E] uppercase tracking-wider block mb-2">
                ¿TIENES CÓDIGO DE DESCUENTO?
              </span>
              <div class="flex gap-2">
                <input
                  type="text"
                  id="page-coupon-input"
                  placeholder="CARDTEROS10"
                  class="flex-1 px-3 py-2 rounded-lg bg-[#181818] border border-[#2c2c2c] text-xs font-mono text-[#EDE4BE] uppercase placeholder-[#555] focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#EDE4BE]"
                />
                <button
                  type="button"
                  id="page-coupon-apply"
                  class="px-4 py-2 rounded-lg bg-[#222222] hover:bg-[#EDE4BE] hover:text-black text-xs font-mono font-bold text-[#EDE4BE] transition-colors cursor-pointer"
                >
                  APLICAR
                </button>
              </div>
              <p id="page-coupon-status" class="text-[10px] font-mono mt-1.5 hidden"></p>
            </div>

            <!-- Botón de Pago Principal -->
            <button
              type="button"
              id="page-checkout-btn"
              class="w-full py-4 px-6 rounded-full font-heading text-lg font-bold tracking-widest uppercase bg-[#EDE4BE] text-black hover:bg-white active:scale-[0.98] transition-all flex items-center justify-center gap-3 cursor-pointer shadow-[0_10px_25px_rgba(237,228,190,0.2)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#00E5FF]"
            >
              <span>CONTINUAR AL CHECKOUT</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>

            <!-- Pasarelas de Pago Oficiales -->
            <div class="pt-3 border-t border-[#1e1e1e] text-center">
              <span class="text-[10px] font-mono text-[#666] uppercase tracking-wider block mb-2.5">
                MÉTODOS DE PAGO ACEPTADOS
              </span>
              <div class="flex items-center justify-center gap-3 text-xs font-mono text-[#888] flex-wrap">
                <span class="px-2.5 py-1 rounded bg-[#1c1c1c] border border-[#2a2a2a]">VISA</span>
                <span class="px-2.5 py-1 rounded bg-[#1c1c1c] border border-[#2a2a2a]">MASTERCARD</span>
                <span class="px-2.5 py-1 rounded bg-[#1c1c1c] border border-[#2a2a2a]">AMEX</span>
                <span class="px-2.5 py-1 rounded bg-[#1c1c1c] border border-[#2a2a2a]">SPEI</span>
                <span class="px-2.5 py-1 rounded bg-[#1c1c1c] border border-[#2a2a2a]">APPLE PAY</span>
              </div>
            </div>

          </div>
        </div>

      </div>

    </div>
  </div>
</MainLayout>

<script>
  import {
    cartItems,
    incrementQuantity,
    decrementQuantity,
    removeFromCart,
    appliedCoupon,
    fulfillmentMode,
    FREE_SHIPPING_THRESHOLD_MXN
  } from '../stores/cart';

  const emptyView = document.getElementById('full-cart-empty');
  const contentView = document.getElementById('full-cart-content');
  const itemsList = document.getElementById('full-cart-items-list');
  const countBadge = document.getElementById('full-cart-items-count');
  const subtotalEl = document.getElementById('page-cart-subtotal');
  const totalEl = document.getElementById('page-cart-total');
  const shippingEl = document.getElementById('page-cart-shipping');
  const discountRow = document.getElementById('page-cart-discount-row');
  const discountLabel = document.getElementById('page-cart-discount-label');
  const discountValue = document.getElementById('page-cart-discount-value');
  const couponInput = document.getElementById('page-coupon-input') as HTMLInputElement | null;
  const couponApplyBtn = document.getElementById('page-coupon-apply');
  const couponStatus = document.getElementById('page-coupon-status');
  const checkoutBtn = document.getElementById('page-checkout-btn');

  const formatMxn = (amount: number) =>
    new Intl.NumberFormat('es-MX', {
      style: 'currency',
      currency: 'MXN',
      maximumFractionDigits: 0
    }).format(amount);

  // Renderizado dinámico de la página de Carrito
  const renderPage = () => {
    const items = cartItems.get();
    const list = Object.values(items);
    const count = list.reduce((acc, curr) => acc + curr.quantity, 0);

    if (countBadge) countBadge.textContent = `${count} ${count === 1 ? 'ARTÍCULO' : 'ARTÍCULOS'}`;

    if (list.length === 0) {
      emptyView?.classList.remove('hidden');
      contentView?.classList.add('hidden');
      return;
    }

    emptyView?.classList.add('hidden');
    contentView?.classList.remove('hidden');

    const subtotal = list.reduce((acc, item) => acc + item.priceMxn * item.quantity, 0);
    if (subtotalEl) subtotalEl.textContent = formatMxn(subtotal);

    // Envío gratis condicional
    if (shippingEl) {
      if (subtotal >= FREE_SHIPPING_THRESHOLD_MXN) {
        shippingEl.textContent = 'GRATIS';
        shippingEl.className = 'text-emerald-400 font-bold';
      } else {
        shippingEl.textContent = formatMxn(250);
        shippingEl.className = 'text-[#8E8E8E]';
      }
    }

    // Cupones
    let discountAmount = 0;
    const coupon = appliedCoupon.get();
    if (coupon && discountRow && discountLabel && discountValue) {
      if (coupon.discountPercent > 0) {
        discountAmount = Math.round((subtotal * coupon.discountPercent) / 100);
      } else if (coupon.amountMxn) {
        discountAmount = coupon.amountMxn;
      }
      discountRow.classList.remove('hidden');
      discountRow.classList.add('flex');
      discountLabel.textContent = `DESCUENTO (${coupon.code})`;
      discountValue.textContent = `-${formatMxn(discountAmount)}`;
    } else if (discountRow) {
      discountRow.classList.add('hidden');
      discountRow.classList.remove('flex');
    }

    const shippingCost = subtotal >= FREE_SHIPPING_THRESHOLD_MXN ? 0 : 250;
    const grandTotal = Math.max(0, subtotal - discountAmount + shippingCost);
    if (totalEl) totalEl.textContent = formatMxn(grandTotal);

    // Reconstruir lista de items
    if (itemsList) {
      itemsList.innerHTML = '';
      list.forEach((item) => {
        const li = document.createElement('li');
        li.className = 'py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 group';
        li.innerHTML = `
          <!-- Info Izquierda: Imagen y Títulos -->
          <div class="flex items-center gap-4 min-w-0">
            <div class="w-20 h-20 rounded-xl bg-[#0c0c0c] border border-[#222222] p-2 flex items-center justify-center shrink-0">
              <img src="${item.imageUrl || ''}" alt="${item.title}" class="max-w-full max-h-full object-contain" />
            </div>
            <div class="min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-[10px] font-mono text-[#A72027] uppercase tracking-wider font-bold">OFICIAL</span>
                <span class="text-[10px] font-mono text-[#666]">•</span>
                <span class="text-[10px] font-mono text-[#888] uppercase tracking-wider">${item.type === 'box' ? 'CAJA SELLADA' : 'CARTA COLECCIÓN'}</span>
              </div>
              <h3 class="font-heading text-lg text-[#EDE4BE] group-hover:text-white transition-colors truncate uppercase leading-tight">
                ${item.title}
              </h3>
              <p class="text-xs font-mono text-[#777] mt-0.5">
                Precio unitario: ${formatMxn(item.priceMxn)}
              </p>
            </div>
          </div>

          <!-- Controles Derecha: Stepper y Subtotal de Línea -->
          <div class="flex items-center justify-between sm:justify-end gap-6 pt-3 sm:pt-0 border-t sm:border-t-0 border-[#222222]">
            <div class="inline-flex items-center rounded-xl bg-[#181818] border border-[#2e2e2e] p-1" role="group">
              <button
                type="button"
                data-action="dec"
                class="w-7 h-7 flex items-center justify-center text-[#EDE4BE] hover:text-white hover:bg-[#252525] rounded-lg transition-colors font-bold cursor-pointer"
                aria-label="Disminuir"
              >
                -
              </button>
              <span class="w-8 text-center text-xs font-mono font-bold text-white select-none">
                ${item.quantity}
              </span>
              <button
                type="button"
                data-action="inc"
                class="w-7 h-7 flex items-center justify-center text-[#EDE4BE] hover:text-white hover:bg-[#252525] rounded-lg transition-colors font-bold cursor-pointer"
                aria-label="Aumentar"
              >
                +
              </button>
            </div>

            <div class="text-right min-w-28">
              <span class="font-heading text-xl text-[#EDE4BE] tracking-wider block">
                ${formatMxn(item.priceMxn * item.quantity)}
              </span>
            </div>

            <button
              type="button"
              data-action="del"
              class="text-[#444] hover:text-[#FF4D57] p-2 transition-colors cursor-pointer rounded-lg hover:bg-[#1a1a1a]"
              title="Eliminar producto"
              aria-label="Eliminar ${item.title}"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            </button>
          </div>
        `;

        li.querySelector('[data-action="dec"]')?.addEventListener('click', () => decrementQuantity(item.id));
        li.querySelector('[data-action="inc"]')?.addEventListener('click', () => incrementQuantity(item.id));
        li.querySelector('[data-action="del"]')?.addEventListener('click', () => removeFromCart(item.id));

        itemsList.appendChild(li);
      });
    }
  };

  cartItems.subscribe(renderPage);
  appliedCoupon.subscribe(renderPage);

  // Cupones en página
  couponApplyBtn?.addEventListener('click', () => {
    const code = couponInput?.value.trim().toUpperCase() || '';
    if (!couponStatus) return;

    if (code === 'CARDTEROS10' || code === 'CARDTEROS') {
      appliedCoupon.set({ code, discountPercent: 10 });
      couponStatus.textContent = '✓ Código CARDTEROS10 aplicado (10% descuento)';
      couponStatus.className = 'text-[10px] font-mono mt-1 text-emerald-400 block';
    } else if (code === '') {
      appliedCoupon.set(null);
      couponStatus.className = 'hidden';
    } else {
      couponStatus.textContent = '✕ Cupón inválido';
      couponStatus.className = 'text-[10px] font-mono mt-1 text-[#FF4D57] block';
    }
  });

  // Modalidad de entrega en página
  const sealedCard = document.getElementById('card-mode-sealed');
  const streamCard = document.getElementById('card-mode-stream');
  sealedCard?.addEventListener('click', () => {
    fulfillmentMode.set('ship_sealed');
    sealedCard.classList.add('border-2', 'border-[#EDE4BE]', 'bg-[#1a1a1a]');
    sealedCard.classList.remove('border', 'border-[#2a2a2a]', 'bg-[#121212]', 'opacity-80');
    streamCard?.classList.remove('border-2', 'border-[#EDE4BE]', 'bg-[#1a1a1a]');
    streamCard?.classList.add('border', 'border-[#2a2a2a]', 'bg-[#121212]', 'opacity-80');
  });

  streamCard?.addEventListener('click', () => {
    fulfillmentMode.set('rip_on_stream');
    streamCard.classList.add('border-2', 'border-[#EDE4BE]', 'bg-[#1a1a1a]');
    streamCard.classList.remove('border', 'border-[#2a2a2a]', 'bg-[#121212]', 'opacity-80');
    sealedCard?.classList.remove('border-2', 'border-[#EDE4BE]', 'bg-[#1a1a1a]');
    sealedCard?.classList.add('border', 'border-[#2a2a2a]', 'bg-[#121212]', 'opacity-80');
  });

  checkoutBtn?.addEventListener('click', () => {
    alert('Simulación de Checkout CARDTEROS: ¡Pedido listo para pasarela de pago bancario encriptado!');
  });
</script>
